# Keep this repo focused on reproducible code + lightweight metadata.

# Python cache/build
**/__pycache__/
**/*.py[cod]
**/*.pyo
**/*.pyd
**/.pytest_cache/
**/*.egg-info/

# Local virtual environments
**/.venv/

# Large local datasets and generated outputs (kept locally, untracked in git)
data/challenge-2019/
data/mimic_demo/
data/mimic_iv_demo_v2_2/
data/patients.csv.gz
data/raw_datasets/
data/tmp_dl/
data/sepsis_causal_artifacts/
data/sepsis_causal_artifacts_bundle/

# Local bundles/archives
*.tar
*.tar.gz
*.zip

# Keep lightweight data metadata/docs
!data/README.md
!data/dataset_audit_summary.json
!data/metric_direction_targets.md
!data/proposal_extracted.txt
!data/docs/
!data/docs/**
